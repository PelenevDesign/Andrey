# Apache (Бегет). Положить в корень сайта (public_html).
DirectoryIndex index.html
Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Адреса без .html: /gidrorez -> gidrorez.html, /tpost/stoleshnica -> tpost/stoleshnica.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Старый адрес с .html -> без .html (один адрес у страницы, как в canonical и sitemap)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^ /%1 [R=301,L]

# index.html -> /
RewriteRule ^index$ / [R=301,L]
</IfModule>

# Служебные файлы не отдаём
<FilesMatch "(^README\.md$|^\.git|\.py$|\.log$)">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteRule ^\.git - [F,L]
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml
</IfModule>

# Кэш браузера
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/javascript "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
